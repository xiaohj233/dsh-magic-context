{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "lib": ["ES2022"],
        "types": ["node"],
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "baseUrl": ".",
        "paths": {
            "@magic-context/core/*": ["../plugin/src/*"],
            "@cortexkit/retina-local-fs/*": ["../retina-local-fs/dist/types/*", "../retina-local-fs/src/*"],
            "dsh-magic-context-adapter": ["../adapter-api/src/index.ts"],
            "dsh-magic-context-adapter/*": ["../adapter-api/src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
